     public class LoginWindow : Adw.ApplicationWindow {
         AnilistGtkApp app;
 
+        [GtkChild]
+        private unowned Gtk.Entry client_id_entry;
+
+        [GtkChild]
+        private unowned Gtk.Entry token_entry;
+
 		public LoginWindow(AnilistGtkApp app) {
 			Object (application: app);
 		    this.app = app;
+            client_id_entry.text = app.settings.get_string("client-id");
 		}
 
         [GtkCallback]
 		public void open_browser_login() {
+            var client_id = client_id_entry.text.strip();
+            if(client_id == "") {
+                client_id = "5986";
+            }
+            app.settings.set_string("client-id", client_id);
+
+            var uri = @"https://anilist.co/api/v2/oauth/authorize?client_id=$client_id&response_type=token";
 		    try {
-                AppInfo.launch_default_for_uri(AnilistClient.OAUTH_URI, null);
+                AppInfo.launch_default_for_uri(uri, null);
             } catch(Error e) {
                 error(e.message);
             }
 		}
+
+        [GtkCallback]
+        public void save_token() {
+            var token = token_entry.text.strip();
+            if(token == "") {
+                return;
+            }
+
+            app.client.store_token.begin(token, (obj, res) => {
+                app.client.store_token.end(res);
+                app.finish_login();
+            });
+        }
     }
 }
